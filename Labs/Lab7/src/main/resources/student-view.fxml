<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Line?>

<AnchorPane prefHeight="660.0" prefWidth="860.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="fu.se.lab7.controller.StudentController"
            stylesheets="@style.css">

    <VBox spacing="0"
          AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
          AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

        <!-- ── HEADER ── -->
        <HBox styleClass="header-panel" alignment="CENTER_LEFT" spacing="12">
            <!-- Icon placeholder (blue square accent) -->
            <VBox minWidth="4" prefHeight="40"
                  style="-fx-background-color: #BBDEFB; -fx-background-radius: 2;"/>
            <VBox spacing="2">
                <Label text="Qu&#7843;n L&#253; Sinh Vi&#234;n" styleClass="header-title"/>
                <Label text="H&#7879; th&#7889;ng th&#432; vi&#7879;n — Library Management System" styleClass="header-subtitle"/>
            </VBox>
        </HBox>

        <!-- ── BODY ── -->
        <VBox spacing="14" VBox.vgrow="ALWAYS">
            <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>

            <!-- ── FORM CARD ── -->
            <VBox styleClass="card" spacing="14">

                <Label text="Th&#244;ng tin sinh vi&#234;n" styleClass="section-label"/>

                <!-- Row 1: Email & First Name -->
                <GridPane hgap="16" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="90" minWidth="80"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="160"/>
                        <ColumnConstraints prefWidth="90" minWidth="80"/>
                        <ColumnConstraints hgrow="ALWAYS" minWidth="160"/>
                    </columnConstraints>

                    <Label text="Email"           styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtEmail" promptText="student@example.com"
                               GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity"/>

                    <Label text="T&#234;n"          styleClass="form-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                    <TextField fx:id="txtFirstName" promptText="Nguy&#7877;n"
                               GridPane.columnIndex="3" GridPane.rowIndex="0" maxWidth="Infinity"/>

                    <Label text="M&#7853;t kh&#7849;u" styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                    <PasswordField fx:id="txtPassword" promptText="&#9679;&#9679;&#9679;&#9679;&#9679;&#9679;"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1" maxWidth="Infinity"/>

                    <Label text="H&#7885;"           styleClass="form-label" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                    <TextField fx:id="txtLastName" promptText="V&#259;n An"
                               GridPane.columnIndex="3" GridPane.rowIndex="1" maxWidth="Infinity"/>

                    <Label text="&#272;i&#7875;m"    styleClass="form-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                    <TextField fx:id="txtMarks" promptText="0.0 - 10.0"
                               GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="160"/>
                </GridPane>

                <!-- Divider -->
                <Separator/>

                <!-- Action Buttons -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="btnAdd"    text="+ Th&#234;m"      onAction="#handleAddStudent"    styleClass="btn-add"    prefWidth="120"/>
                    <Button fx:id="btnUpdate" text="&#9998; C&#7853;p nh&#7853;t" onAction="#handleUpdateStudent" styleClass="btn-update" prefWidth="130"/>
                    <Button fx:id="btnDelete" text="- X&#243;a"        onAction="#handleDeleteStudent" styleClass="btn-delete" prefWidth="120"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="X&#243;a form" onAction="#handleClear" styleClass="btn-clear" prefWidth="110"/>
                </HBox>
            </VBox>

            <!-- ── TABLE CARD ── -->
            <VBox styleClass="card" spacing="10" VBox.vgrow="ALWAYS">
                <Label text="Danh s&#225;ch sinh vi&#234;n" styleClass="section-label"/>

                <TableView fx:id="studentTable" VBox.vgrow="ALWAYS" minHeight="260">
                    <columns>
                        <TableColumn fx:id="idColumn"        text="ID"                          prefWidth="50"  minWidth="40"/>
                        <TableColumn fx:id="emailColumn"     text="Email"                       prefWidth="190" minWidth="120"/>
                        <TableColumn fx:id="passwordColumn"  text="M&#7853;t kh&#7849;u"        prefWidth="100" minWidth="80"/>
                        <TableColumn fx:id="firstNameColumn" text="T&#234;n"                    prefWidth="100" minWidth="80"/>
                        <TableColumn fx:id="lastNameColumn"  text="H&#7885;"                    prefWidth="100" minWidth="80"/>
                        <TableColumn fx:id="marksColumn"     text="&#272;i&#7875;m"             prefWidth="70"  minWidth="60"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <VBox alignment="CENTER" spacing="8">
                            <Label text="Ch&#432;a c&#243; d&#7919; li&#7879;u sinh vi&#234;n" style="-fx-text-fill: #90A4AE; -fx-font-size: 14px;"/>
                        </VBox>
                    </placeholder>
                </TableView>
            </VBox>

        </VBox>
    </VBox>

</AnchorPane>
